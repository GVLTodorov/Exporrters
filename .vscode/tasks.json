{
  // Terminal > Run Task...
  "version": "2.0.0",
  "tasks": [
    { "label": "test: mikrotik", "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/mikrotik" }, "problemMatcher": "$go", "group": "test" },
    { "label": "test: ping",     "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/ping" },     "problemMatcher": "$go", "group": "test" },
    { "label": "test: stock",    "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/stock" },    "problemMatcher": "$go", "group": "test" },
    { "label": "test: weather",  "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/weather" },  "problemMatcher": "$go", "group": "test" },
    {
      "label": "test: all Go exporters",
      "dependsOn": ["test: mikrotik", "test: ping", "test: stock", "test: weather"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "xiaomi: create venv",
      "type": "shell",
      "command": "python -m venv .venv && .venv/bin/pip install -e .",
      "windows": { "command": "python -m venv .venv; if ($?) { .venv/Scripts/pip install -e . }" },
      "options": { "cwd": "${workspaceFolder}/xiaomi" },
      "problemMatcher": []
    },
    {
      "label": "docker: up (pick exporter)",
      "type": "shell",
      "command": "docker compose up --build ${input:exporter}",
      "problemMatcher": []
    },
    {
      "label": "docker: up all",
      "type": "shell",
      "command": "docker compose up --build",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "release: preview next versions",
      "detail": "What CI would release if you pushed to main now",
      "type": "shell",
      "command": "for e in mikrotik ping stock weather xiaomi; do echo \"== $e\"; bash .github/scripts/next-version.sh $e; done",
      "windows": { "command": "$g = Split-Path (Get-Command git).Source; $bash = @(\"$g/bash.exe\", \"$g/../bin/bash.exe\") | Where-Object { Test-Path $_ } | Select-Object -First 1; foreach ($e in 'mikrotik','ping','stock','weather','xiaomi') { \"== $e\"; & $bash .github/scripts/next-version.sh $e }" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "exporter",
      "type": "pickString",
      "description": "Exporter",
      "options": ["mikrotik", "ping", "stock", "weather", "xiaomi"]
    }
  ]
}
