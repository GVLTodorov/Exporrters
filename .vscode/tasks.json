{
  // Terminal > Run Task...
  "version": "2.0.0",
  "tasks": [
    { "label": "test: binance",  "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/binance" },  "problemMatcher": "$go", "group": "test" },
    { "label": "test: mikrotik", "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/mikrotik" }, "problemMatcher": "$go", "group": "test" },
    { "label": "test: ping",     "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/ping" },     "problemMatcher": "$go", "group": "test" },
    { "label": "test: stock",    "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/stock" },    "problemMatcher": "$go", "group": "test" },
    { "label": "test: weather",  "type": "shell", "command": "go test ./... -cover", "options": { "cwd": "${workspaceFolder}/weather" },  "problemMatcher": "$go", "group": "test" },
    {
      "label": "test: all Go exporters",
      "dependsOn": ["test: binance", "test: mikrotik", "test: ping", "test: stock", "test: weather"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "test: leak tests (pick exporter)",
      "detail": "goroutine / connection / heap / series leak tests, verbose",
      "type": "shell",
      "command": "go test ./... -run Leak -count=1 -v",
      "options": { "cwd": "${workspaceFolder}/${input:goExporter}" },
      "problemMatcher": "$go",
      "group": "test"
    },
    {
      "label": "test: xiaomi",
      "detail": "unit + leak tests (needs the xiaomi venv)",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -v",
      "windows": { "command": ".venv/Scripts/python -m pytest -v" },
      "options": { "cwd": "${workspaceFolder}/xiaomi" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "xiaomi: create venv",
      "detail": "needs Python 3.11 (python-miio 0.4.7 does not install on newer versions)",
      "type": "shell",
      "command": "python3.11 -m venv .venv && .venv/bin/pip install -e '.[test]'",
      "windows": { "command": "py -3.11 -m venv .venv; if ($?) { .venv/Scripts/pip install -e '.[test]' }" },
      "options": { "cwd": "${workspaceFolder}/xiaomi" },
      "problemMatcher": []
    },
    {
      "label": "soak: run 30 min",
      "detail": "All exporters in Docker, scraped like Prometheus; report in soak/results/",
      "type": "shell",
      "command": "python soak/soak.py --duration 30m",
      "problemMatcher": []
    },
    {
      "label": "docker: up (pick exporter)",
      "type": "shell",
      "command": "docker compose up --build ${input:exporter}",
      "problemMatcher": []
    },
    {
      "label": "docker: up all",
      "type": "shell",
      "command": "docker compose up --build",
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "release: preview next versions",
      "detail": "What CI would release if you pushed to main now",
      "type": "shell",
      "command": "for e in binance mikrotik ping stock weather xiaomi; do echo \"== $e\"; bash .github/scripts/next-version.sh $e; done",
      "windows": { "command": "$g = Split-Path (Get-Command git).Source; $bash = @(\"$g/bash.exe\", \"$g/../bin/bash.exe\") | Where-Object { Test-Path $_ } | Select-Object -First 1; foreach ($e in 'binance','mikrotik','ping','stock','weather','xiaomi') { \"== $e\"; & $bash .github/scripts/next-version.sh $e }" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "goExporter",
      "type": "pickString",
      "description": "Go exporter",
      "options": ["binance", "mikrotik", "ping", "stock", "weather"]
    },
    {
      "id": "exporter",
      "type": "pickString",
      "description": "Exporter",
      "options": ["binance", "mikrotik", "ping", "stock", "weather", "xiaomi"]
    }
  ]
}
